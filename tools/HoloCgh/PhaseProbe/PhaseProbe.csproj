<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PhaseProbe</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <!-- the EFMPlus encoder and tables are internal to DvdImageSolver: compile the (GPL) sources into this tool instead of patching DIS -->
    <Compile Include="$(DisRoot)src/DvdImageSolver/Encoding/EfmPlus*.cs;$(DisRoot)src/DvdImageSolver/Encoding/NrziCodewordMetrics.cs" LinkBase="DisEncoding" />
    <ProjectReference Include="$(DisRoot)src/DvdImageSolver/DvdImageSolver.csproj" />
  </ItemGroup>
</Project>
