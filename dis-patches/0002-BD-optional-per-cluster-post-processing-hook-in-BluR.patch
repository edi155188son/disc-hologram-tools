+/// <summary>Optional last edit of a complete 32-sector cluster payload, called once per cluster after the
+/// mapping has filled it and before the per-cluster scrambler is removed, so <paramref name="cluster"/>
+/// holds the values that end up on the disc (post-scrambler domain, 32 x 2048 bytes).
+/// It may be invoked concurrently for different clusters and must be thread-safe.</summary>
+public delegate void BluRayClusterPostProcessor(BluRayDiscParameters disc, uint firstSector,
+    uint physicalSectorNumber, Span<byte> cluster);
+
 public sealed record BluRayStreamingOptions(BluRayDiscParameters Disc, uint StartSector = 0, uint SectorCount = 32)
 {
+    /// <summary>Hook for research tools that need to post-process whole clusters (for example to make the
+    /// drive-generated parity bytes follow a pattern). Null for every built-in caller.</summary>
+    public BluRayClusterPostProcessor? ClusterPostProcessor { get; init; }
+
     public long ContentLength => (long)SectorCount * BluRayDiscParameters.BytesPerSector;
     public void Validate()
     {
@@ -75,10 +86,10 @@ public static class BluRayStreamingGenerator
