+    private static void TestClusterPostProcessor()
+    {
+        // The hook sees each complete cluster exactly once, in the post-scrambler domain, before the
+        // scrambler is removed: flipping every byte there flips every output byte, on the sequential
+        // and on the parallel (raster) path alike, and leaves the default (no hook) output unchanged.
+        BluRayDiscParameters disc = new();
+        byte[] pixels = new byte[256 * 256];
+        for (int i = 0; i < pixels.Length; i++) pixels[i] = (byte)((i / 5 & 1) == 0 ? 0 : 255);
+        BluRayGray8Raster raster = new(256, 256, pixels);
+        foreach (IBluRayPayloadMapping mapping in new IBluRayPayloadMapping[]
+            { new BluRayConstantByteMapping(0x3c), new BluRayImagePayloadMapping(disc, raster, new BluRayRunLengthMapping(0x9E, 0x22)) })
+        {
+            BluRayStreamingOptions plain = new(disc, 64, 32 * 6);
+            var calls = new System.Collections.Concurrent.ConcurrentBag<(uint First, uint Psn)>();
+            BluRayStreamingOptions hooked = plain with
+            {
+                ClusterPostProcessor = (d, first, psn, cluster) =>
+                {
+                    Require(cluster.Length == BluRayDiscParameters.PayloadBytesPerCluster && ReferenceEquals(d, disc),
+                        "hook receives a whole cluster and the disc parameters");
+                    calls.Add((first, psn));
+                    for (int i = 0; i < cluster.Length; i++) cluster[i] ^= 0xFF;
+                },
+            };
+            using MemoryStream a = new(), b = new();
+            BluRayStreamingGenerator.GenerateToStream(a, plain, mapping);
+            BluRayStreamingGenerator.GenerateToStream(b, hooked, mapping);
+            byte[] pa = a.ToArray(), pb = b.ToArray();
+            Require(pa.Length == pb.Length && pa.Length == 32 * 6 * 2048, "hook keeps the output length");
+            for (int i = 0; i < pa.Length; i++)
+                Require((byte)(pa[i] ^ 0xFF) == pb[i], "hook edits are applied before the scrambler is removed");
+            var expected = Enumerable.Range(0, 6).Select(c => (First: 64U + (uint)c * 32, Psn: disc.GetPhysicalSectorNumber(64U + (uint)c * 32))).ToArray();
+            Require(calls.OrderBy(c => c.First).SequenceEqual(expected), "hook runs exactly once per cluster with its first sector and PSN");
+        }
+    }
+
