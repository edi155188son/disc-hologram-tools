+            : $"{StereoViews} × {System.IO.Path.GetFileName(ImagePath)}";
+
+    partial void OnStereoViewsChanged(int value)
+    {
+        int clamped = Math.Clamp(value, ProjectStereoSettings.MinViews, ProjectStereoSettings.MaxViews);
+        if (clamped != value) StereoViews = clamped;
+    }
+
+    partial void OnStereoHogelMmChanged(double value)
+    {
+        if (!double.IsFinite(value)) { StereoHogelMm = 0.2; return; }
+        double clamped = Math.Clamp(value, ProjectStereoSettings.MinHogelMm, ProjectStereoSettings.MaxHogelMm);
+        if (clamped != value) StereoHogelMm = clamped;
+    }
+
+    partial void OnStereoCopiesChanged(int value)
