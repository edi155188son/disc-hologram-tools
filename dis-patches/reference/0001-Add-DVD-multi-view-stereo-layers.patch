+    [ObservableProperty] private bool _stereoReverseViews;
+
+    public bool HasStereoViewFiles => StereoViewPaths.Count > 0;
+
+    public bool HasStereoDepthMap => !string.IsNullOrWhiteSpace(StereoDepthMapPath);
+
+    /// <summary>The view count is fixed by the files when explicit views are chosen.</summary>
