+        int clamped = Math.Clamp(value, 1, ProjectStereoSettings.MaxCopies);
+        if (clamped != value) StereoCopies = clamped;
+    }
+
+    partial void OnStereoParallaxMmChanged(double value)
+    {
+        if (!double.IsFinite(value)) { StereoParallaxMm = 0; return; }
+        double clamped = Math.Clamp(value, 0, ProjectStereoSettings.MaxParallaxMm);
