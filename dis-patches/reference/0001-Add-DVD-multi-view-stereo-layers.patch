+                StereoDepthMapPath, StereoViews, StereoParallaxMm, StereoHogelMm, StereoCopies, StereoReverseViews);
+
+    public void ApplyStereo(ProjectStereoSettings? stereo)
+    {
+        if (stereo is null) return;
+        StereoViewPaths = stereo.ViewPaths?.ToList() ?? [];
