+    /// <summary>DVD stereo layers repeated round the disc: the extra copies are drawn faded so
+    /// the editable original stays obvious. Each copy is the whole layer rotated about the disc
+    /// centre, exactly as the stereo overlay writes it.</summary>
+    private void DrawStereoCopies(DrawingContext context, DesignLayerViewModel layer, double widthPx, double heightPx)
+    {
+        if (_design is null || !_design.IsDvd || !layer.IsStereo || layer.StereoCopies <= 1)
+        {
+            return;
+        }
+
+        Point discCenter = ScreenFromMm(0, 0);
+        Point topLeft = ScreenFromMm(
+            layer.TranslateXMm - SizeWidthMm(layer) / 2,
+            layer.TranslateYMm - SizeHeightMm(layer) / 2);
+        context.PushOpacity(0.45);
+        for (int copy = 1; copy < layer.StereoCopies; copy++)
+        {
+            double angle = 360.0 * copy / layer.StereoCopies;
+            TransformGroup transform = new();
+            transform.Children.Add(new TranslateTransform(topLeft.X, topLeft.Y));
+            transform.Children.Add(new RotateTransform(
+                layer.RotationDeg,
+                topLeft.X + widthPx / 2,
+                topLeft.Y + heightPx / 2));
+            transform.Children.Add(new RotateTransform(angle, discCenter.X, discCenter.Y));
+            context.PushTransform(transform);
+            context.DrawImage(layer.Image, new Rect(0, 0, widthPx, heightPx));
+            context.Pop();
+        }
+        context.Pop();
+    }
+
